ARG OL_VERSION_MAJOR="9"

FROM oraclelinux:${OL_VERSION_MAJOR}

ARG OL_VERSION_MAJOR
# ^ This has to appear again. It is intended. Else "FROM" consumes it.

ARG WITH_UNIREC=0
ARG WITH_CLICKHOUSE=0
ENV WITH_UNIREC=${WITH_UNIREC}
ENV WITH_CLICKHOUSE=${WITH_CLICKHOUSE}

RUN dnf -y install oracle-epel-release-el${OL_VERSION_MAJOR} && \
    dnf config-manager --set-enabled ol${OL_VERSION_MAJOR}_appstream ol${OL_VERSION_MAJOR}_codeready_builder

RUN dnf install -y \
        git gcc gcc-c++ cmake make python3-docutils zlib-devel librdkafka-devel \
        libxml2-devel lz4-devel libzstd-devel \
        dnf-plugins-core \
        rpm-build \
        rsync \
        rpmdevtools

RUN if [ "${WITH_UNIREC}" = 1 ]; then \
        dnf copr enable -y @CESNET/NEMEA && \
        dnf update -y && \
        dnf install -y nemea libtrap-devel unirec;\
    fi

COPY ./rpm-builder.sh /rpm-builder.sh

CMD /bin/bash /rpm-builder.sh
